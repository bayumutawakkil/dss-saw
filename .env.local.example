# Supabase Configuration
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_URL="your_supabase_url_here"
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url_here"

# PostgreSQL Configuration
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="your_postgres_host_here"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_PRISMA_URL="your_postgres_prisma_url_here"
POSTGRES_URL="your_postgres_url_here"
POSTGRES_URL_NON_POOLING="your_postgres_url_non_pooling_here"
POSTGRES_USER="postgres"

# Supabase Keys (DO NOT SHARE!)
SUPABASE_JWT_SECRET="your_jwt_secret_here"
SUPABASE_SECRET_KEY="your_secret_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual Supabase credentials
# 3. Get credentials from: https://supabase.com/dashboard → Your Project → Settings → API
# 4. NEVER commit .env.local to git!